# ---- LLM (any LiteLLM model id: anthropic/..., openai/..., gemini/..., groq/..., ollama/...) ----
LLM_MODEL=anthropic/claude-sonnet-5-5      # research + writing steps
LLM_FAST_MODEL=anthropic/claude-haiku-5-5  # router (optional; defaults to LLM_MODEL)
LLM_API_KEY=                               # your provider API key
LLM_API_BASE=                              # optional: custom / OpenAI-compatible endpoint (e.g. http://localhost:11434 for Ollama)
LLM_TIMEOUT=60

# ---- Django ----
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Assistant limits ----
ASSISTANT_MAX_TOOL_CALLS=6
ASSISTANT_HISTORY_TURNS=8
ASSISTANT_RATE_LIMIT=30          # messages per session per 5 minutes

# ---- Data (optional overrides) ----
# SCORECARD_DB_PATH=data/scorecard.duckdb
# SCORECARD_API_KEY=            # normally read automatically from the public Scorecard site bundle
# SCORECARD_CMS_KEY=
